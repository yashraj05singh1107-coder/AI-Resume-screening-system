# Default: local SQLite database (no database server setup needed)
DATABASE_URL=sqlite:///resume_screening.db
SECRET_KEY=change-this-for-any-shared-or-production-deployment
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# For MySQL (install a compatible DB driver, e.g. PyMySQL):
# DATABASE_URL=mysql+pymysql://username:password@localhost/resume_screening
# For PostgreSQL (install psycopg):
# DATABASE_URL=postgresql+psycopg://username:password@localhost/resume_screening
